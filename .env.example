# Where Next's dev/prod server forwards /api requests (the running Canopy backend).
# The browser always calls the same-origin /api/* path; next.config.mjs rewrites it here.
BACKEND_ORIGIN=http://localhost:3000

# Base path the in-browser API client uses. Leave as /api — it resolves against
# the rewrite above, so the browser never makes a cross-origin request.
NEXT_PUBLIC_API_BASE=/api

# OR call the backend directly (like the farmer/platform panels) instead of the
# rewrite — set this to the backend origin (inlined at build time). When set, it
# takes precedence over NEXT_PUBLIC_API_BASE / the rewrite.
#   NEXT_PUBLIC_API_TARGET=https://canopy-backend.onrender.com
